---
import { Icon } from 'astro-icon/components';

import normalFace from '@assets/faces/rounded-face-2.webp'
import trollFace from '@assets/faces/rounded-face-3.webp'
import sillyFace from '@assets/faces/rounded-face-4.webp'
import seriousFace from '@assets/faces/rounded-face-5.webp'

const devFaces = [normalFace, trollFace, sillyFace, seriousFace]

---
<section class="hero-container" id="hero-section">
    <div class="texts-container">
        <h1 class="texts-container__title">¡HOLA!<br>SOY <span class="highlighted">NEHUEN</span><span class="highlighted">CUENCA</span><img class="dev-face" src={devFaces[0].src} alt="Cara de Nehuen"></h1>
        <h2 class="texts-container__subtitle">y quiero superarme como <br> <strong>desarrollador web</strong></h2>
    </div>
    <div class="divider">
        <div class="divider__line divider__line_left"></div>
        <a href="#formation-section" class="arrow-button" aria-label="Next section">
            <Icon class='arrow-button__icon' name="bx:down-arrow-circle" size={40} />
        </a>
        <div class="divider__line divider__line_right"></div>
    </div>
</section>

<script define:vars={{ devFaces }}>  
    const devFaceImage = document.querySelector('.dev-face')
    let devFaceIndex = 0
    let devFaceInterval = null

    const changeDevFaceImage = (seconds) => {
        if (seconds <= 0) throw Error(`Bad argument seconds given (${seconds}) to change a image`)

        devFaceInterval = setInterval(() => {
            devFaceIndex = (devFaceIndex === devFaces.length-1) ? 0 : ++devFaceIndex
            devFaceImage.src = devFaces[devFaceIndex].src
        }, seconds)
    };

    const observer = new IntersectionObserver( (entries) => {
        entries.forEach((entry) => {
            if(!entry.isIntersecting){
                clearInterval(devFaceInterval)
            } else {
                changeDevFaceImage(1_000)
            }
        })
    })

    setTimeout(() => {
        observer.observe( devFaceImage )
    }, 2_000);    
</script>

<style>
    .hero-container{
        padding: 2rem 1rem;
        height: clamp(470px, 90vh, 90vh);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
    }

    .texts-container{
        margin: auto 0;
    }

    .texts-container__title, 
    .texts-container__subtitle {
        text-align: center;
    }

    .texts-container__title{
        font: normal normal 100 clamp(2.5rem, 12vw, 5rem) var(--display-font, Tahoma);
        color: var(--color-titles);
        margin: 1rem 0 1.5rem 0;
        animation: fadeFromCenter 1.5s ease 0s 1 normal forwards;
    }

    .highlighted{
        font-weight: 800;
	    color: var(--color-bg);
        background-color: var(--color-titles);
        padding: 0 10px;
        margin: 5px 0;
        letter-spacing: 2px;
        display: inline-block;
        transition: color .25s ease, background .25s ease;
    }

    .texts-container__subtitle{
        font: normal normal 150 clamp(1.7rem, 8vw, 3rem) var(--default-font, Arial);
        text-wrap: balance;
        opacity: 0;
        animation: fadeFromTop 1s ease .5s 1 normal forwards;
    }

    .dev-face{
        display: inline;
        height: 0;
        rotate: 45deg;
        z-index: -1;
        position: relative;
        right: 80px;
        font: normal normal 150 clamp(1.7rem, 8vw, 2rem) var(--default-font, Arial);
        animation: entryFromLeft 1s ease 2s 1 normal forwards;
    }

    .divider{
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: var(--color-titles);
    }

    .divider__line{
        width: calc(((100% / 2) - 2rem) - 10vw);
        height: 2px;
        background-color: var(--color-titles);
        opacity: 0; 
    }


    .divider__line_left{
        animation: scaleUpFromLeft .8s linear 1s 1 normal forwards;
    }
    .divider__line_right{
        animation: scaleUpFromRight .8s linear 1s 1 normal forwards;
    }

    .arrow-button__icon{
        width: clamp(40px, 10vw, 70px);
        height: clamp(40px, 10vh, 70px);
        opacity: 0;
        transition: scale .25s ease;
        animation: 
            fadeFromCenter 1s ease 1.8s 1 normal forwards,
            pulseRegular 1s ease 1.8s 7 normal forwards;
    }

    .arrow-button__icon:hover{
        scale: 1.1;
        animation-play-state: paused;
    }

    @keyframes entryFromLeft {
        100% {
            height: clamp(3.5rem, 12vw, 5rem);
            translate: 80px 0;
        }
    }

    @keyframes pulseRegular {
        0%, 100% { transform: scale(1); }

        50% { transform: scale(1.1); }
    }

    @keyframes scaleUpFromLeft {
        0%, 100%{ 
            transform-origin: 0% 0%;
            opacity: 1;
        }
        
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
    }

    @keyframes scaleUpFromRight {
        0%, 100%{ 
            transform-origin: 100% 0%;
            opacity: 1;
        }
        
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
    }

    @keyframes fadeFromTop {
        0% {
            opacity: 0;
            transform: translateY(-50px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeFromCenter {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }
</style>