---
import { Icon } from 'astro-icon/components';

import devFaceGIF from '@assets/gifs/dev_face_gif.gif'

---
<section class="hero-container" id="hero-section">
    <div class="hero-container__texts">
        <h1 class="hero-container__title">
            ¡HOLA!<br>SOY 
            <span class="highlighted">NEHUEN</span><span class="highlighted highlighted_with-gif">CUENCA<img class="highlighted__dev-face" src={devFaceGIF.src} alt="Cara de Nehuen"></span>
        </h1>
        <h2 class="hero-container__subtitle">Desarrollador web enfocado en UX/UI.</h2>
        <h3 class="hero-container__phrase">“Construyo sitios que no solo funcionan, sino que destacan.”</h3>
    </div>
    <div class="hero-container__divider">
        <div class="hero-container__divider-line hero-container__divider-line_left"></div>
        <a href="#formation-section" class="hero-container__next-section-link" aria-label="Next section">
            <Icon class='hero-container__next-section-link-icon' name="bx:down-arrow-circle" size={40}/>
        </a>
        <div class="hero-container__divider-line hero-container__divider-line_right"></div>
    </div>
</section>

<style>
    .hero-container {
        padding: 0 1rem;
        height: clamp(470px, 90vh, 90vh);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-around;
    }
    .hero-container__texts {
        width: 80dvw;
        /* margin: auto 0; */
        text-align: center;
    }
    .hero-container__title {
        font: normal normal 400 clamp(var(--heading-md-fs), 5vw, var(--display-lg-fs)) var(--display-font, Tahoma);
        color: var(--title-color);
        margin: .5rem 0 1rem 0;
        animation: fadeFromCenter .5s ease 0s 1 normal forwards;
    }
    .highlighted {
        font-weight: 800;
	    color: var(--primary-bg-color);
        background-color: var(--title-color);
        padding: 0 10px;
        margin: 5px 0;
        letter-spacing: 2px;
        display: inline-block;
        transition: color .25s ease, background .25s ease;
    }
    .highlighted_with-gif {
        position: relative;
    }
    .highlighted__dev-face {
        height: 0;
        rotate: 45deg;
        position: absolute;
        right: 50%;
        top: 0;
        z-index: -1;
        font: normal normal 150 clamp(1.7rem, 5vw, 2rem) var(--default-font, Arial);
        animation: entryFromLeft .5s ease 3s 1 normal forwards;
    }
    .hero-container__subtitle {
        font: normal normal 600 clamp(var(--subtitle-fs), 4vw, 3rem) var(--default-font, Arial);
        color: var(--subtitle-color);
        margin-bottom: .5rem;
        animation: fadeFromTop 1s ease .5s 1 normal forwards;
    }
    .hero-container__phrase {
        font: italic normal 300 clamp(var(--body-md-fs), 3vw, 2rem) var(--default-font, Arial);
        color: var(--phrase-color);
        animation: fadeFromTop 1s ease 1s 1 normal forwards;
    }

    .hero-container__subtitle,
    .hero-container__phrase {
        text-wrap: balance;
        opacity: 0;
    }

    .hero-container__divider {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: var(--title-color);
        align-self: flex-end;
    }
    .hero-container__divider-line {
        width: calc(((100% / 2) - 2rem) - 10vw);
        height: 2px;
        background-color: var(--title-color);
        opacity: 0; 
    }
    .hero-container__divider-line_left {
        animation: scaleUpFromLeft 1s linear 2s 1 normal forwards;

    }
    .hero-container__divider-line_right {
        animation: scaleUpFromRight 1s linear 2s 1 normal forwards;
    }

    .hero-container__next-section-link {}

    .hero-container__next-section-link-icon {
        width: clamp(40px, 10vw, 70px);
        height: clamp(40px, 10vh, 70px);
        opacity: 0;
        transition: scale .25s ease;
        animation: fadeFromCenter 1s ease 3s 1 normal forwards,
                pulseRegular 1s ease 3s 7 normal forwards;
    }

    .hero-container__next-section-link-icon:hover{
        scale: 1.1;
        animation-play-state: paused;
    }

    @keyframes entryFromLeft {
        100% {
            height: clamp(2.5rem, 5.5vw, 5rem);
            translate: 100% 0;
            right: 0;
        }
    }

    @keyframes pulseRegular {
        0%, 100% { transform: scale(1); }

        50% { transform: scale(1.1); }
    }

    @keyframes scaleUpFromLeft {
        0%, 100%{ 
            transform-origin: 0% 0%;
            opacity: 1;
        }
        
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
    }

    @keyframes scaleUpFromRight {
        0%, 100%{ 
            transform-origin: 100% 0%;
            opacity: 1;
        }
        
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
    }

    @keyframes fadeFromTop {
        0% {
            opacity: 0;
            transform: translateY(-50px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeFromCenter {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }
</style>