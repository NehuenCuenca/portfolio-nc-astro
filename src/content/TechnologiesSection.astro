---
import toolImages from '@assets/technologies'
import TechnologyDrawer from '@components/TechnologyDrawer.astro';
---

<section class="technologies-container" id="technologies-section">
    <div class="container-headings">
        <h1 class="container-headings__title">Tecnologias</h1>
        <h2 class="container-headings__subtitle">Herramientas con las que me familiarizo</h2>
    </div>
    <ul class="skills-list">
        <TechnologyDrawer drawerName="Frontend" drawerIcon="bx:slideshow" toolsImages={toolImages.frontendToolsImages} />
        <TechnologyDrawer drawerName="Backend" drawerIcon="bx:data" toolsImages={toolImages.backendToolsImages} />
        <TechnologyDrawer drawerName="Diseño" drawerIcon="bx:paint" toolsImages={toolImages.designToolsImages} />
        <TechnologyDrawer drawerName="Otros" drawerIcon="bx:wrench" toolsImages={toolImages.othersToolsImages} />
    </ul>
</section>


<script>
    const drawerButtons = document.querySelectorAll('[data-drawer-button]');
    drawerButtons.forEach((drawerButton) => {
        drawerButton.addEventListener('click', (event) => {
            const arrowButton = event.currentTarget.querySelector('.arrow-button');
            const technologiesList = event.currentTarget.nextElementSibling;
            
            technologiesList.classList.toggle('technologies-list_opened')
            arrowButton.classList.toggle('arrow-button_opened')
        });
    });
</script>

<style>
    .technologies-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding: 2rem 0;
    }

    .skills-list{
        width: 100%;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 2rem 1rem;
    }  

    @media (width >= 600px){
        .skills-list{
            padding: 0;
            flex-direction: row;
            justify-content: center;
            gap: 2rem;
        }
    }
</style>