---

import LogoHTML from '@assets/technologies/html-logo-removebg-preview.webp'
import LogoJavascript from '@assets/technologies/javascript-logo-removebg-preview.webp'
import LogoCss from '@assets/technologies/css-logo-removebg-preview.webp'
import LogoVue from '@assets/technologies/vue-logo-removebg-preview.webp'
import LogoReact from '@assets/technologies/react-logo-removebg-preview.webp'
import LogoMySql from '@assets/technologies/mysql-logo-removebg-preview.webp'
import LogoPostgreSql from '@assets/technologies/postgresql-logo-removebg-preview.webp'
import LogoPhp from '@assets/technologies/php-logo-removebg-preview.webp'
import LogoLaravel from '@assets/technologies/laravel-logo-removebg-preview.webp'
import LogoNode from '@assets/technologies/node-logo-removebg-preview.webp'
import LogoExpress from '@assets/technologies/express-logo-removebg-preview.webp'
import LogoFigma from '@assets/technologies/figma-logo-removebg-preview.webp'
import LogoPhotoScape from '@assets/technologies/photoscape-x-logo-removebg-preview.webp'
import LogoPostman from '@assets/technologies/postman-logo-removebg-preview.webp'
import LogoNotion from '@assets/technologies/notion-logo-removebg-preview.webp'
import LogoNetlify from '@assets/technologies/netlify-logo-removebg-preview.webp'
import LogoGit from '@assets/technologies/git-logo-removebg-preview.webp'
import LogoGithub from '@assets/technologies/github-logo-removebg-preview.webp'
import TechnologyDrawer from "@components/TechnologyDrawer.astro";

LogoHTML.alt = 'LogoHTML'
LogoJavascript.alt = 'LogoJavascript'
LogoCss.alt = 'LogoCss'
LogoVue.alt = 'LogoVue'
LogoReact.alt = 'LogoReact'
LogoMySql.alt = 'LogoMySql'
LogoPostgreSql.alt = 'LogoPostgreSql'
LogoPhp.alt = 'LogoPhp'
LogoLaravel.alt = 'LogoLaravel'
LogoNode.alt = 'LogoNode'
LogoExpress.alt = 'LogoExpress'
LogoFigma.alt = 'LogoFigma'
LogoPhotoScape.alt = 'LogoPhotoScape'
LogoPostman.alt = 'LogoPostman'
LogoNotion.alt = 'LogoNotion'
LogoNetlify.alt = 'LogoNetlify'
LogoGit.alt = 'LogoGit'
LogoGithub.alt = 'LogoGithub'

const frontendToolsImages = [LogoHTML,LogoCss,LogoJavascript,LogoVue,LogoReact]
const backendToolsImages = [LogoMySql,LogoPostgreSql,LogoPhp,LogoLaravel,LogoNode,LogoExpress]
const designToolsImages = [LogoFigma,LogoPhotoScape]
const othersToolsImages = [LogoGit,LogoGithub,LogoPostman,LogoNetlify,LogoNotion]

---

<section class="technologies-container" id="technologies-section">
    <div class="container-headings">
        <h1 class="container-headings__title">Tecnologias</h1>
        <h2 class="container-headings__subtitle">Herramientas con las que me familiarizo</h2>
    </div>
    <ul class="skills-list">
        <TechnologyDrawer drawerName="Frontend" drawerIcon="bx:slideshow" toolsImages={frontendToolsImages} />
        <TechnologyDrawer drawerName="Backend" drawerIcon="bx:data" toolsImages={backendToolsImages} />
        <TechnologyDrawer drawerName="Diseño" drawerIcon="bx:paint" toolsImages={designToolsImages} />
        <TechnologyDrawer drawerName="Otros" drawerIcon="bx:wrench" toolsImages={othersToolsImages} />
    </ul>
</section>


<script>
    const drawerButtons = document.querySelectorAll('[data-drawer-button]');
    drawerButtons.forEach((drawerButton) => {
        drawerButton.addEventListener('click', (event) => {
            const arrowButton = event.currentTarget.querySelector('.arrow-button');
            const technologiesList = event.currentTarget.nextElementSibling;
            
            const technologiesListIsClosed = technologiesList.classList.contains('technologies-list_closed')
            if( technologiesListIsClosed ){
                technologiesList.classList.remove('technologies-list_closed')
                arrowButton.classList.remove('arrow-button_closed')
                technologiesList.classList.add('technologies-list_opened')
                arrowButton.classList.add('arrow-button_opened')
            } else {
                technologiesList.classList.remove('technologies-list_opened')
                arrowButton.classList.remove('arrow-button_opened')
                technologiesList.classList.add('technologies-list_closed')
                arrowButton.classList.add('arrow-button_closed')
            }
        });
    });
</script>

<style>
    .technologies-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding: 2rem 0;
    }

    .skills-list{
        width: 100%;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 2rem 1rem;
    }  

    @media (width >= 600px){
        .skills-list{
            padding: 0;
            flex-direction: row;
            justify-content: center;
            gap: 2rem;
        }
    }
</style>