---
import SkillCard from "@components/SkillCard.astro";

const skills = [
    {
        skillIcon: 'bx:desktop',
        skillName: 'Frontend',
        skillDescription: 'Creando interfaces dinámicas, responsivas y fáciles de usar con frameworks y librerías modernas.',
        technologiesList: [
            {
                techIcon: 'simple-icons:html5',
                techName: 'HTML'
            },
            {
                techIcon: 'simple-icons:css',
                techName: 'CSS'
            },
            {
                techIcon: 'simple-icons:javascript',
                techName: 'Javascript' 
            },
            {
                techIcon: 'simple-icons:typescript',
                techName: 'Typescript'
            },
            {
                techIcon: 'simple-icons:vuedotjs',
                techName: 'Vue'
            },
            {
                techIcon: 'simple-icons:vite',
                techName: 'Vite'
            },
            {
                techIcon: 'simple-icons:vitest',
                techName: 'Vitest'
            },
            {
                techIcon: 'simple-icons:react',
                techName: 'React'
            },
            {
                techIcon: 'simple-icons:astro',
                techName: 'Astro'
            },
        ]
    },
    {
        skillIcon: 'bx:data',
        skillName: 'Backend',
        skillDescription: 'Desarrollando lógica de servidor, APIs y bases de datos robustas para aplicaciones web eficientes.',
        technologiesList: [
            {
                techIcon: 'simple-icons:mysql',
                techName: 'MySQL'
            },
            {
                techIcon: 'simple-icons:postgresql',
                techName: 'PostgreSQL'
            },
            {
                techIcon: 'simple-icons:php',
                techName: 'PHP'
            },
            {
                techIcon: 'simple-icons:laravel',
                techName: 'Laravel'
            },
            {
                techIcon: 'simple-icons:nodedotjs',
                techName: 'NodeJS'
            },
            {
                techIcon: 'simple-icons:express',
                techName: 'Express'
            },
        ]
    },
    {
        skillIcon: 'bx:paint',
        skillName: 'Diseño',
        skillDescription: 'Transformando ideas en diseños intuitivos y visuales pulidos para una experiencia de usuario fluida.',
        technologiesList: [
            {
                techIcon: 'simple-icons:figma',
                techName: 'Figma'
            },
            {
                techIcon: 'bx:camera',
                techName: 'Photoscape'
            },
        ]
    },
    {
        skillIcon: 'bx:wrench',
        skillName: 'Otros',
        skillDescription: 'Herramientas esenciales para flujos de desarrollo, colaboración y gestión de proyectos.',
        technologiesList: [
            {
                techIcon: 'simple-icons:git',
                techName: 'GIT'
            },
            {
                techIcon: 'simple-icons:github',
                techName: 'GitHub'
            },
            {
                techIcon: 'simple-icons:postman',
                techName: 'Postman'
            },
            {
                techIcon: 'simple-icons:netlify',
                techName: 'Netlify'
            },
            {
                techIcon: 'simple-icons:notion',
                techName: 'Notion'
            },
        ]
    },
]
---

<section class="technologies-container" id="technologies-section">
    <svg class="technologies-container__divider" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 1000 100">
        <g fill="var(--color-bg)">
            <rect fill="var(--color-details)" width="100%" height="100%"/>
            <path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 77 666.7 77 833.3 28 1000 28V0H0Z" opacity=".5"></path>
            <path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 70 666.7 70 833.3 16 1000 16V0H0Z" opacity=".5"></path>
            <path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 63 666.7 63 833.3 4 1000 4V0H0Z"></path>
        </g>
    </svg>

    <div class="container-headings container-headings_tech-section">
        <h1 class="container-headings__title">Tecnologías</h1>
        <h2 class="container-headings__subtitle">Herramientas con las que me familiarizo</h2>
    </div>
    <ul class="skills-list">
        {
            skills.map(({skillIcon, skillName, skillDescription, technologiesList }) => <SkillCard skillIcon={skillIcon} skillName={skillName} skillDescription={skillDescription} technologiesList={technologiesList}/>)
        }
    </ul>
</section>

<style>
    .technologies-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        background-color: var(--color-details);
        overflow-x: hidden;
        padding: 0 0 10dvh 0;
    }
    
    .container-headings_tech-section {
        margin: 10dvh;
    }

    .technologies-container__divider {
        background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 1000 100"><g fill="%23E3FEF7"><path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 77 666.7 77 833.3 28 1000 28V0H0Z" opacity=".5"></path><path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 70 666.7 70 833.3 16 1000 16V0H0Z" opacity=".5"></path><path d="M0 0v100c166.7 0 166.7-66 333.3-66S500 63 666.7 63 833.3 4 1000 4V0H0Z"></path></g></svg>');
        height: 10dvh;
    }

    .skills-list{
        max-width: 1280px;
        display: flex;
        flex-wrap: wrap;
        align-items: start;
        justify-content: center;
        gap: 5rem;
        padding: 0 1rem;
    } 

    @media (width >= 768px) {
        .technologies-container__divider {
            height: 25dvh;
        }
    }

    @media (width >= 1280px) {
        .technologies-container__divider {
            height: 35dvh;
        }
    }
</style>