---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import dev_ilustration from '@assets/ilustrations/solve-it-dev-converted.png'
import ContactForm from "@components/ContactForm.vue";

---

<section class="contact-container" id="contact-section">
    <div class="container-headings">
        <h1 class="container-headings__title">¡Contáctame!</h1>
        <!-- <h2 class="container-headings__subtitle"></h2> -->
    </div>

    <div class="contact-container__content">
        <ContactForm client:load/>

        <div class="contact-container__formal-links">
            <ul class="contact-container__formal-links-list">
                <li class="contact-container__formal-link-item">
                    <Icon class="contact-container__formal-link-item-icon" name="bx:mail-send" size={40} />
                    <span class="contact-container__formal-link-item-text">Email</span>
                    <a href="mailto:nehuen.cuenca@yahoo.com" class="contact-container__formal-link-item-link">nehuen.cuenca@yahoo.com</a>
                </li>
                <li class="contact-container__formal-link-item contact-ways-list-item">
                    <Icon class="contact-container__formal-link-item-icon" name="mdi:linkedin" size={40} />
                    <span class="contact-container__formal-link-item-text">LinkedIn</span>
                    <a href="https://www.linkedin.com/in/nehuen-cuenca/" target="_blank" class="contact-container__formal-link-item-link">Nehuen Cuenca</a>
                </li>
            </ul>
            <Image src={dev_ilustration} alt="Ilustracion de un programador saludando desde su escritorio" class="contact-container__dev-img">
        </div>
    </div>
</section>

<style>
    .contact-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding-bottom: 15dvh;
    }

    .contact-container__content{
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4rem 1rem;
    }

    .contact-container__formal-links{
        width: clamp(300px, 50%, 450px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5dvh;
    }

    .contact-container__formal-links-list{
        display: flex;
        flex-direction: column;
        gap: 5dvh;
    }

    .contact-container__formal-link-item {
        display: grid;
        grid-template-areas: 
            "icon name"
            "icon link"
        ;
        grid-template-columns: 40px 1fr;
        gap: 1dvh 1dvw;
        padding: .5rem 0 ;
    }
    .contact-container__formal-link-item-icon{
        grid-area: icon;
    }
    .contact-container__formal-link-item-icon,
    .contact-container__formal-link-item-text{
        color: var(--title-color);
    }
    .contact-container__formal-link-item-text{
        grid-area: name;
        font: normal normal 300 clamp(var(--subtitle-fs), 7vw, var(--heading-sm-fs)) var(--display-font, Tahoma);
    }
    .contact-container__formal-link-item-link {
        grid-area: link;
        font: normal normal 300 clamp(var(--body-sm-fs), 6vw, var(--subtitle-fs)) var(--default-font, Arial);
        color: var(--paragraph-color);
    }

    .contact-container__dev-img{
        object-fit: contain;
        width: clamp(200px, 100%, 250px);
        height: min-content;
        border-radius: 10px;
        box-shadow: 4px 4px 10px var(--shadow-color);
        background: var(--primary-bg-color);
        background: linear-gradient(180deg, var(--primary-bg-color) 0%, var(--title-color) 100%);
    }

    @media (width >= 768px){
        .contact-container__content{
            flex-direction: row-reverse;
        }
    }
</style>