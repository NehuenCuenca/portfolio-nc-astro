---
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear()
---
<footer class="footer-container">
    <span class="footer-container__dev-signature">Nehuen Cuenca © 2024 - {currentYear}</span>
    <ul class="footer-container__contact-links-list">
        <li class="footer-container__contact-link-list-item">
            <a href="mailto:nehuen.cuenca@yahoo.com" class="footer-container__contact-link-list-item-link" aria-label="Mail">
                <Icon name="bx:mail-send" size={35} />
            </a>
        </li>
        <li class="footer-container__contact-link-list-item">
            <a href="https://www.linkedin.com/in/nehuen-cuenca/" target="_blank" class="footer-container__contact-link-list-item-link" aria-label="LinkedIn">
                <Icon name="mdi:linkedin" size={35} /> 
            </a>
        </li>
        <li class="footer-container__contact-link-list-item">
            <a href="https://github.com/NehuenCuenca" target="_blank" class="footer-container__contact-link-list-item-link" aria-label="GitHub">
                <Icon name="mdi:github" size={35} />
            </a>
        </li>
    </ul>
</footer>

<style>
.footer-container{
    width: 100%;
    padding: 1rem;
    background-color: var(--title-color);
    color: var(--primary-bg-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}
.footer-container__dev-signature{
    font: normal normal 200 clamp(1.3rem, 6vw, 1.5rem) var(--display-font, Tahoma);
    text-align: center;
    text-wrap: balance;
}

.footer-container__contact-links-list{
    display: flex;
    gap: 2rem;
}
.footer-container__contact-link-list-item {
    color: var(--secondary-bg-color);
    transition: color .3s ease;
}
.footer-container__contact-link-list-item:hover{
    color: var(--primary-bg-color);
}

@media (width >= 768px) {
    .footer-container{
        flex-direction: row;
        justify-content: space-between;
    }
}

</style>