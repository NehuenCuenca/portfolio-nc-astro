---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const { nameTitle, image, externalLinks, idx } = Astro.props;
const hasDemoAvailable = externalLinks.hasOwnProperty('demo')
---

<li class="project-card-item">
    <div class="project-card-item__img-wrapper">
        <Image class="project-card-item__img" alt={`Proyecto de ${nameTitle}`}  src={image}/>
        <div class="project-card-item__wrapper-overlay">
            {
                (hasDemoAvailable)
                ? <a class="project-card-item__open-demo-link" href={externalLinks.demo} target="_blank">
                    <Icon class="project-card-item__open-demo-link-icon" name="bx:link-external" size={50}/>
                    <span class="project-card-item__open-demo-link-text">Abrir</span>
                  </a>
                : <div class="project-card-item__open-demo-link project-card-item__open-demo-link_not-available">
                    <Icon class="project-card-item__open-demo-link-icon" name="bx:x-circle" size={50}/>
                    <span class="project-card-item__open-demo-link-text">No disponible</span>
                  </div>
            }
        </div>
    </div>
    {
        (hasDemoAvailable) 
        ? <a class="project-card-item__name-title" href={externalLinks.demo} target="_blank">{ nameTitle }</a>
        : <span class="project-card-item__name-title project-card-item__name-title_not-available" title="No disponible">{ nameTitle }</span>
    }
    <div class="project-card-item__aux-actions">
        <button type="button" class="project-card-item__more-info-btn" data-idx={idx} title="Mostrar mas información" aria-role="Mostrar información">
            <Icon class="project-card-item__more-info-btn-icon" name="bx:info-circle" size={25}/>
        </button>
        <a href={externalLinks.repository} target="_blank" class="project-card-item__open-repository-link" title="Abrir repositorio de GitHub" aria-role="Abrir repositorio de GitHub">
            <Icon class="project-card-item__open-repository-link-icon" name="simple-icons:github" size={25}/>
        </a>
    </div>
</li>

<style>
    .project-card-item{
        --wrapper-border-radius: 10px;

        --wrapperImg-max-width: 250px;
        --wrapperImg-max-height: 300px;
        
        display: grid;
        grid-template-columns: var(--wrapperImg-max-width);
        grid-auto-rows: min-content;
        grid-template-areas: 
            "projectImg"
            "projectName"
            "projectAuxActions"
        ;
        justify-items: center;
        align-items: start;
        gap: 1rem;
    }

    .project-card-item__img-wrapper {
        grid-area: projectImg;
        position: relative;
        background-color: var(--primary-bg-color);
        border-radius: var(--wrapper-border-radius);
        box-shadow: 10px 10px 20px -5px var(--shadow-color);
        -webkit-box-shadow: 10px 10px 20px -5px var(--shadow-color);
        -moz-box-shadow: 10px 10px 20px -5px var(--shadow-color);
    }

    .project-card-item__img {
        object-fit: cover;
    }

    .project-card-item__wrapper-overlay {
        border-radius: var(--wrapper-border-radius);
        position: absolute;
        top: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        -webkit-tap-highlight-color: transparent;
        color: transparent;
        transition: opacity .3s ease, color .3s ease, backdrop-filter .3s ease, background-color .3s ease/* , z-index .3s ease */;
        /* opacity: 0; */
        /* z-index: -1; */
    }

    .project-card-item__img-wrapper:hover .project-card-item__wrapper-overlay {
        opacity: 1;
        color: var(--primary-color-100);
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(3px);
        /* z-index: 1; */
    }

    .project-card-item__img, 
    .project-card-item__wrapper-overlay {
        height: var(--wrapperImg-max-height);
        width: var(--wrapperImg-max-width);
        border-radius: var(--wrapper-border-radius);
    }

    .project-card-item__open-demo-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--primary-color-100);
    }
    .project-card-item__open-demo-link-icon {
        opacity: 0.8;
    }
    .project-card-item__img-wrapper:hover .project-card-item__wrapper-overlay .project-card-item__open-demo-link-icon {
        opacity: 1;
    }

    .project-card-item__open-demo-link-text {
        opacity: 0;
        font: normal normal 500 var(--subtitle-fs) var(--display-font, Tahoma);
    }
    .project-card-item__img-wrapper:hover .project-card-item__wrapper-overlay .project-card-item__open-demo-link-text{
        opacity: 1;
    }

    .project-card-item__open-demo-link_not-available {
        color: var(--error-color-500);
        pointer-events: none;
    }

    .project-card-item__name-title {
        grid-area: projectName;
        font: normal normal 500 var(--subtitle-fs) var(--display-font, Tahoma);
        color: var(--title-color);
        text-align: center;
        transition: color .3s ease;
        line-height: 150%;
    }

    .project-card-item__name-title:hover {
        color: var(--subtitle-color);
        text-decoration: underline;
        text-underline-offset: 6px
    }

    .project-card-item__name-title_not-available{
        cursor: not-allowed;
    }
    .project-card-item__name-title_not-available:hover {
        color: var(--error-text-color);
    } 

    .project-card-item__aux-actions {
        grid-area: projectAuxActions;
        display: flex;
        gap: 1.5rem;
    }

    .project-card-item__more-info-btn {
        padding: 0;
    }
    .project-card-item__open-repository-link {}

    .project-card-item__more-info-btn-icon,
    .project-card-item__open-repository-link-icon {
        color: var(--phrase-color);
        --icon-size: 35px;
        width: var(--icon-size);
        height: var(--icon-size);
        transition: color .3s ease;
    }

    :is( .project-card-item__more-info-btn-icon, .project-card-item__open-repository-link-icon ):hover{
        color: var(--title-color)
    }

    @media (width >= 768px) {
        .project-card-item{
            width: var(--wrapperImg-max-width);
            grid-template-columns: 60% 40%;
            grid-template-rows: var(--wrapperImg-max-height) auto;
            grid-template-areas: 
                "projectImg projectImg"
                "projectName projectAuxActions"
            ;
            gap: 1rem 0;
            justify-items: normal;
        }        

        .project-card-item__name-title {
            text-align: start;
        }

        .project-card-item__aux-actions {
            gap: .5rem;
            align-items: start;
            justify-self: end;
        }

        .project-card-item__more-info-btn-icon,
        .project-card-item__open-repository-link-icon {
            --icon-size: 25px;
            width: var(--icon-size);
            height: var(--icon-size);
        }

        :is( .project-card-item__more-info-btn-icon, .project-card-item__open-repository-link-icon ):hover{
            color: var(--title-color);
        }
    }
</style>