---
const { title, ...props } = Astro.props;
---
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<title>{title}</title>
<meta name="description" content="¡Te doy la bienvenida a la reciente version 2 de mi portfolio!">

<!-- Web analytics -->
<!-- <script data-goatcounter="https://my-account.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script> -->

<!-- Open Graph tags -->
<meta property="og:title" content="Portfolio v2 de Nehuen Cuenca" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://portfolio-astro-nc.netlify.app/" />
<meta property="og:description" content="¡Hola, soy Nehuen Cuenca y te doy la bienvenida a mi portfolio de desarrollador web donde describo mi formacion, proyectos, tecnologias y servicios que puedo ofrecer!" />
<meta property="og:image" content="/linkedin-card-favicon.png">
<!-- <meta property="og:image:alt" content=""> -->

<!-- LinkedIn Recommended -->
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="627">
<meta property="og:site_name" content="Portfolio v2 de Nehuen Cuenca">
<meta property="og:locale" content="es_AR">
<meta property="profile:first_name" content="Nehuen">
<meta property="profile:last_name" content="Cuenca">