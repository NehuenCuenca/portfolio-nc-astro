---
import { Icon } from "astro-icon/components";

const { skillIcon, skillName, skillDescription, technologiesList } = Astro.props;
---

<li class="skill-card-item">
    <div class="skill-card-item__heading skill-card-item-heading">
        <Icon class="skill-card-item__heading-icon skill-card-item-heading__icon" name={skillIcon} size={55}/>
        <h3 class="skill-card-item__heading-title skill-card-item-heading__title">{ skillName }</h3>
    </div>
    <p class="skill-card-item__description">{ skillDescription }</p>
    <ul class="skill-card-item__technologies-list">
        {
            technologiesList.map( ({techIcon, techName}) => <li class="technology-card-item">
                <Icon class="technology-card-item__icon" name={techIcon} size={30}/>
                <h4 class="technology-card-item__name">{techName}</h4>
            </li>)
        }
    </ul>
</li>

<style>
    .skill-card-item {
        width: clamp(340px, 100%, 400px);
        background-color: var(--color-bg);
        padding: 2rem 1rem;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem 0;
    }

    .skill-card-item__heading{
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
    }

    .skill-card-item__heading-icon {
        color: var(--color-font);
    }

    .skill-card-item__heading-title {
        /* font: normal normal 500 clamp(2rem, 8vw, 2.5rem) var(--display-font, Tahoma); */
        font: normal normal 500 clamp(var(--subtitle-fs), 8vw, var(--heading-sm-fs)) var(--display-font, Tahoma);
        color: var(--color-titles);
    }

    .skill-card-item__description {
        /* font: normal normal 400 clamp(1.1rem, 5vw, 1.4rem) var(--default-font, Arial); */
        font: normal normal 400 clamp(var(--body-sm-fs), 5vw, var(--body-lg-fs)) var(--default-font, Arial);
        color: var(--color-font);
        text-align: center;
        max-width: 90%;
    }

    .skill-card-item__technologies-list {
        margin-top: 1rem;
        height: 330px;
        padding: 0 0 1rem 0;
        overflow-y: auto;
        width: 100%;
        display: grid;
        justify-content: center;
        grid-template-columns: repeat(2, clamp(100px, 45%, 150px));
        gap: 1rem;
    }

    .technology-card-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem 0;
        background-color: var(--secondary-bg-color);
        -webkit-box-shadow: 4px 4px 0px 0px var(--skill-card-shadow);
        -moz-box-shadow: 4px 4px 0px 0px var(--skill-card-shadow);
        box-shadow: 4px 4px 0px 0px var(--skill-card-shadow);
        padding: .5rem 0;
    }
    .technology-card-item__icon {
        width: clamp(35px, 30%, 80px);
        height: clamp(35px, 30%, 80px);
        color: var(--color-font);
    }
    .technology-card-item__name {
        /* font: normal normal 500 1rem var(--display-font, Tahoma); */
        font: normal normal 500 var(--caption-fs) var(--display-font, Tahoma);
        color: var(--color-titles);
        text-align: center;
        text-transform: capitalize;
    }

    @media (width >= 425px) {
        .skill-card-item__heading{
            flex-direction: row;
            gap: 1rem;
        }
    }
</style>