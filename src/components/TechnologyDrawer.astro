---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const { drawerName, drawerIcon, toolsImages } = Astro.props;
---

<li class="skills-list-item skills-list-item_hover">
    <button data-drawer-button={drawerName} class="skills-list-item__dropdown-button">
        <Icon name={drawerIcon} class="skill-icon" size={35}/>
        <h2 class="skill-name">{drawerName}</h2>
        <Icon name="bx:caret-down" size={40} class="arrow-button" />
    </button>
    
    <ul class="technologies-list">
        {Object.keys(toolsImages).map( (toolName) => <li class="technologies-list-item">
            <Image class="technologies-list-item__technology-image" src={toolsImages[toolName]} alt={`${toolName.toUpperCase()}`} title={`${toolName.toUpperCase()}`}/>
        </li>)}
    </ul>
</li>


<style>
    .skills-list-item{ width: 100%;}

    .skills-list-item__dropdown-button{
        width: 100%;
        padding: .5rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: border .3s ease;
        border: 2px dashed var(--color-font);
        border-top: 2px dashed transparent;
        border-radius: 0 0 20px 20px;
        transition: background .3s ease;
    }

    .skills-list-item__dropdown-button:hover{
        background-color: var(--color-details);
        border: 2px solid var(--color-font);
        border-top: 2px solid transparent;
    }
    .skills-list-item__dropdown-button:has(.arrow-button_opened){
        border: 2px dashed transparent;
        background-color: transparent;
    }

    .arrow-button{
        transition: rotate .3s ease;
        margin: 0 0 0 auto;
        rotate: 180deg;
    }
    .arrow-button_opened {
        rotate: 0deg;
    }

    .technologies-list{
        background: linear-gradient(to bottom, transparent, var(--color-details));
        position: relative;
        left: 3rem;
        width: calc(100% - 5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem;
        transition: opacity .3s ease, visibility .3s ease, height .5s ease;
        interpolate-size: allow-keywords;
        height: 0;
        opacity: 0;
        visibility: hidden;
    }

    .technologies-list_opened{
        height: auto;
        opacity: 1;
        visibility: visible;
        border-radius: 0 0 20px 20px;
        border-bottom: 3px solid var(--color-font);
    }

    .technologies-list-item{}
    .technologies-list-item__technology-image{}

    .skill-icon,
    .arrow-button{
        color: var(--color-font);
        --icon-size: clamp(2.5rem, 5vw, 3rem);
        width: var(--icon-size);
        height: var(--icon-size);
    }
    .skill-name{
        font: normal normal 400 clamp(2rem, 4.5vw, 2.5rem) var(--display-font, Tahoma);
        color: var(--color-titles);
    }


    @media (width >= 600px){
        .skills-list-item{
            width: 40%;
            gap: .5rem;
        }
    }
</style>