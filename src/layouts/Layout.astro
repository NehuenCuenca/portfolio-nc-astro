---
interface Props {
	title: string;
}

const { title } = Astro.props;

// FONTS
import '@fontsource-variable/nunito';
import '@fontsource/lemon';
import Navbar from '@components/Navbar.vue'
import Footer from '@components/Footer.astro';

---

<!doctype html>
<html lang="es" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="¡Hola, soy Nehuen Cuenca y te doy la bienvenida a mi portfolio de desarrollador web donde describo mi formacion, proyectos, tecnologias y servicios que puedo ofrecer!" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/Sunglasses-Emoji.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<Navbar client:only="vue"/>
		</header>
		<slot />
		<Footer />
	</body>
</html>
<style is:global>
	:root {
		--display-font: 'Lemon', Tahoma;
		--default-font: 'Nunito Variable', sans-serif, Arial;
		--black: #000000;
		--white: #FFFFFF;

		/* OLD PALETTE */
		--aqua-green-dark: #003C43;
		--aqua-green-dark-soft: #135D66;
		--aqua-green-mid-light: #77B0AA;
		--aqua-green-light: #E3FEF7;
		--error-msg: #FF3F3F;

		/* NEW PALETTE */
		--primary-color-900: #003c43;
		--primary-color-800: #064850;
		--primary-color-700: #0e555d;
		--primary-color-600: #22676e;
		--primary-color-500: #488687;
		--primary-color-400: #6ba5a1;
		--primary-color-300: #92c3bc;
		--primary-color-200: #bbe0d9;
		--primary-color-100: #e3fef7;
		--error-color-900: #AF0000;
		--error-color-500: #FF3F3F;
		--error-color-100: #FFB1B1;

		/* FONT SIZE VARS */
		--micro-fs: 12px;
		--caption-fs: 14px;
		--body-sm-fs: 16px;
		--body-md-fs: 18px;
		--body-lg-fs: 20px;
		--subtitle-fs: 24px;
		--heading-sm-fs: 30px;
		--heading-md-fs: 36px;
		--heading-lg-fs: 48px;
		--display-sm-fs: 60px;
		--display-lg-fs: 72px;
	}

	[data-theme="light"] {
		--color-bg: var(--aqua-green-light);
		--color-font: var(--aqua-green-dark-soft);
		--color-titles: var(--aqua-green-dark);
		--color-details: var(--aqua-green-mid-light);
		--color-shadow: rgba(0,0,0, 0.4);
		--projects-fade-bg: linear-gradient(180deg, rgba(119,176,170,1) 95%, rgba(227,254,247,1) 100%);
		background-color: var(--color-bg);
		color: var(--color-font);

		/* NEW COLOR VARS */
		--title-color: var(--primary-color-900);
		--subtitle-color: var(--primary-color-700);
		--phrase-color: var(--primary-color-600);
		--paragraph-color: var(--primary-color-900);
		--primary-bg-color: var(--primary-color-100);
		--secondary-bg-color: var(--primary-color-300);
		--primary-icon-color: var(--primary-color-900);
		--link-color: var(--primary-color-900);
		--decimal-title-color: 0, 60, 67;
		--skill-card-shadow: rgba(var(--decimal-title-color), .6);
		background-color: var(--primary-bg-color);
		color: var(--paragraph-color);
	}

	[data-theme="dark"] {
		--color-bg: var(--aqua-green-dark);
		--color-font: var(--aqua-green-mid-light);
		--color-titles: var(--aqua-green-light);
		--color-details: var(--aqua-green-dark-soft);
		--color-shadow: transparent;
		--projects-fade-bg: linear-gradient(180deg, rgba(19,93,102,1) 95%, rgba(0,60,67,1) 100%);
		background-color: var(--color-bg);
		color: var(--color-font);

		/* NEW COLOR VARS */
		--title-color: var(--primary-color-100);
		--subtitle-color: var(--primary-color-300);
		--phrase-color: var(--primary-color-400);
		--paragraph-color: var(--primary-color-100);
		--primary-bg-color: var(--primary-color-900);
		--secondary-bg-color: var(--primary-color-700);
		--primary-icon-color: var(--primary-color-100);
		--link-color: var(--primary-color-100);
		--decimal-title-color: 227, 254, 247;
		--skill-card-shadow: rgba(var(--decimal-title-color), .6);
		background-color: var(--primary-bg-color);
		color: var(--paragraph-color);
	}

	/* ===== Scrollbar CSS ===== */
	/* Firefox */
	* {
		scrollbar-width: auto;
		scrollbar-color: var(--subtitle-color) var(--primary-bg-color);
	}

	/* Chrome, Edge, and Safari */
	*::-webkit-scrollbar {
		width: 20px;
	}

	*::-webkit-scrollbar-track {
		background: var(--primary-bg-color);
	}

	*::-webkit-scrollbar-thumb {
		background-color: var(--paragraph-color);
		border: 3px solid var(--primary-bg-color);
		border-radius: 10px;
	}

	/* RESETS */
	*, *::before, *::after {
		box-sizing: border-box;
	}
	
	* {
		margin: 0;
	}

	body {
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	img, picture, video, canvas, svg {
		display: block;
		max-width: 100%;
	}

	p {
		overflow-wrap: break-word;
	}

	a { 
		color:inherit;
		text-decoration: none;
	}

	button{
		background-color: transparent;
		border: none;
		cursor: pointer;
	}
	
	ul,ol { 
		list-style-type: none;
		padding: 0
	}

	html {
		font-family: var(--default-font);
		width: 100%;
		scroll-behavior: smooth;
	}

	header {
		width: 100%;
		min-height: 10vh;
		position: sticky;
		top: 0;
		z-index: 9;
	}

	section {
		scroll-margin-block-start: 120px; /*Adds margin to the top of the viewport*/
		scroll-margin-block-end: 120px; /*Adds margin to the bottom of the viewport*/
	}

	dialog::backdrop{
		background: rgba(255, 255, 255, 0.99);
		background: radial-gradient(circle, rgba(255, 255, 255, 0) 0%, rgba(0, 0, 0, 0.8) 100%);
        backdrop-filter: blur(3px);
	}

	strong {
		color: var(--title-color);
	}

	body:has(.mobile-menu_open){
		overflow-y: hidden;
	}

	.container-headings{
		display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
        text-align: center;
		margin-bottom: 2.5dvh;
	}
	.container-headings__title{
        font: normal normal 700 clamp(var(--heading-md-fs), 10vw, var(--display-sm-fs)) var(--display-font, Tahoma);
        color: var(--title-color);
    }
    .container-headings__subtitle{
        font: normal normal 400 clamp(var(--body-lg-fs), 5vw, var(--heading-sm-fs)) var(--default-font, Arial);
        text-wrap: balance;
        color: var(--subtitle-color);
    }
</style>
