---
import Hero from '@content/Hero.astro';
import Layout from '../layouts/Layout.astro';
import FormationSection from '@content/FormationSection.astro';
import ProjectsSection from '@content/ProjectsSection.astro';
import TechnologiesSection from '@content/TechnologiesSection.astro';
import ServicesSection from '@content/ServicesSection.astro';
import ContactSection from '@content/ContactSection.astro';
import ProjectCard from '@components/ProjectCard.astro';

import { projects } from '@data/projects'
import { Icon } from 'astro-icon/components';
---

<Layout title="Nehuen Cuenca | Portfolio v2">
	<main class="main-container">
		<Hero />
		<a href="#hero-section" class="go-to-top-link go-to-top-link_hidden">
			<Icon name="bx:arrow-to-top" size={40} title='Ir a la parte superior'/>
		</a>
		<FormationSection />
		<div class="different-bg">
			<TechnologiesSection />
			<ProjectsSection>
				<ul class="projects-list" slot="projects-list">
					{
						projects.map(({ nameTitle, image, externalLinks, description }, idx) => <ProjectCard nameTitle={nameTitle} image={image} externalLinks={externalLinks} description={description} idx={idx} />)
					}
				</ul>
			</ProjectsSection>
		</div>
		<ServicesSection />
		<ContactSection />
	</main>
	
	<dialog id="last-info-project-dialog" class="info-project-dialog" closedby="closerequest">
		<form class="info-project-dialog__close-form">
			<button formmethod="dialog" class="info-project-dialog__close-button">
				<Icon name="bx:x" size={35} class='info-project-dialog__close-icon' title='Cerrar ventana'/>
			</button>
		</form>
		<div class="info-project-dialog__header">
			<img src="" alt="Una imagen de proyecto no establecida" class="info-project-dialog__header-project-img ">
			<h3 class="info-project-dialog__header-name-title"></h3>
			<ul class="info-project-dialog__header-technologies-list">
				<li class="technology-item">
					<h4 class="technology-item__technology-name"></h4>
				</li>
				<li class="technology-item">
					<h4 class="technology-item__technology-name"></h4>
				</li>
			</ul>
		</div>
		<div class="info-project-dialog__content">
			<p class="info-project-dialog__content-description"></p>
		</div>
	</dialog>
</Layout>

<script define:vars={{ projects }}>
	document.addEventListener('DOMContentLoaded', function() {
		const goToTopLink = document.querySelector('.go-to-top-link');
		const heroSection = document.querySelector('main').querySelectorAll('section')[0];
		
		const tabletMediaQueryPixels = 768;
		let isSeeingHeroSection = false
		
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				const moreOrEqualThanMinimalMediaQuery = window.innerWidth >= tabletMediaQueryPixels
				if ((entry.isIntersecting && moreOrEqualThanMinimalMediaQuery) || !moreOrEqualThanMinimalMediaQuery) {
					isSeeingHeroSection = true
					goToTopLink.classList.add('go-to-top-link_hidden');
				} else {
					isSeeingHeroSection = false
					goToTopLink.classList.remove('go-to-top-link_hidden');
				}
			});
		}, {threshold: 0});

		observer.observe(heroSection);

		function debounce(func, delay) {
			let timeoutId;
			return function(...args) {
				clearTimeout(timeoutId);
				timeoutId = setTimeout(() => {
					func.apply(this, args);
				}, delay);
			};
		}

		const debouncedResizeHandler = debounce(function() {
			const moreOrEqualThanMinimalMediaQuery = window.innerWidth >= tabletMediaQueryPixels
			if (!moreOrEqualThanMinimalMediaQuery || isSeeingHeroSection) {
				goToTopLink.classList.add('go-to-top-link_hidden');
			} else {
				goToTopLink.classList.remove('go-to-top-link_hidden');
			}
		}, 250); // Delay of 250 milliseconds

		window.addEventListener('resize', debouncedResizeHandler);
	});

	// Find all buttons with the `alert` class on the page.
	const openInfoProjectButtons = document.querySelectorAll('button.project-card-item__more-info-btn');
	const infoProjectDialog = document.querySelector("#last-info-project-dialog");

	// Handle clicks on each button.
	openInfoProjectButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const idxProject = button.getAttribute('data-idx')
			const { nameTitle, image, description, technologies } = projects[idxProject]

			const projectImg = infoProjectDialog.querySelector('.info-project-dialog__header-project-img')
			const projectName = infoProjectDialog.querySelector('.info-project-dialog__header-name-title')
			const projectDescription = infoProjectDialog.querySelector('.info-project-dialog__content-description')
			const projectTechnologiesList = infoProjectDialog.querySelector('.info-project-dialog__header-technologies-list')
			const technologiesItems = projectTechnologiesList.querySelectorAll('.technology-item')

			projectImg.src = image.src
			projectImg.alt = `Proyecto ${nameTitle}`
			projectName.textContent = nameTitle
			projectDescription.innerHTML = description
			technologiesItems.forEach((technologyItemElement, idxItemElement) => {
				technologyItemElement.innerHTML = `<h4 class="technology-item__technology-name">${technologies[idxItemElement]?.technologyName || ''}</h4>`
			})

  			infoProjectDialog.showModal();
		});
	});

	infoProjectDialog.addEventListener('close', () => {
		setTimeout( () => {
			const projectImg = infoProjectDialog.querySelector('.info-project-dialog__header-project-img')
			const projectName = infoProjectDialog.querySelector('.info-project-dialog__header-name-title')
			const projectDescription = infoProjectDialog.querySelector('.info-project-dialog__content-description')
			const projectTechnologiesList = infoProjectDialog.querySelector('.info-project-dialog__header-technologies-list')
			const technologiesItems = projectTechnologiesList.querySelectorAll('.technology-item')
			
			projectImg.src = ''
			projectImg.alt = `Imagen de proyecto a detallar...`
			projectName.textContent = 'Titulo de proyecto a detallar'
			projectDescription.innerHTML = 'Descripcion del proyecto...'
			technologiesItems.forEach((technologyItemElement) => {
				technologyItemElement.innerHTML = `<h4 class="technology-item__technology-name"></h4>`
			})
		}, 500)
	})
</script>

<style>
	.main-container, .different-bg{
		display: flex;
		flex-direction: column;
		gap: 5rem;
	}

	.different-bg{
		background-color: var(--secondary-bg-color);
	}

	.info-project-dialog{
		overflow-y: hidden;
		max-height: 75dvh;
		max-width: 100%;
		padding: 0;
		color: var(--color-paragraph);
    	background-color: var(--primary-bg-color);
    	border-top: 8px solid var(--title-color);
    	border-right: 8px solid var(--title-color);
    	border-left: 8px solid var(--title-color);
		border-bottom: none;
    	border-radius: 10px 10px 0px 0px;
		margin: auto 0 0 0;
		opacity: 0;
		--dialog-entrance-exit-timing: 500ms;
		transition:
			display var(--dialog-entrance-exit-timing) allow-discrete,
			overlay var(--dialog-entrance-exit-timing) allow-discrete,
			translate var(--dialog-entrance-exit-timing),
			opacity var(--dialog-entrance-exit-timing);
		translate: 0 50%;
		will-change: translate, opacity;
	}

	.info-project-dialog[open] {
		opacity: 1;
		translate: 0;
		@starting-style {
			opacity: 0;
			translate: 0 50%;
		}
	}

	.info-project-dialog::backdrop {
		opacity: 1;
		transition:
			display var(--dialog-entrance-exit-timing) allow-discrete,
			opacity var(--dialog-entrance-exit-timing);

		@starting-style { opacity: 0 }
	}

	.info-project-dialog:not([open])::backdrop {
		opacity: 0;
	}

	.info-project-dialog__close-form {
		background-color: var(--title-color);
		width: fit-content;
		border-radius: 0 0 0 10px;
		position: absolute;
		top: 0;
		right: 0;
		z-index: 1;
	}

	.info-project-dialog__close-button {
		color: var(--primary-bg-color);
	}
	.info-project-dialog__close-icon {}

	.info-project-dialog__header {
		background-color: var(--title-color);
		color: var(--primary-bg-color);
		display: grid;
		grid-template-columns: 60% 40%;
		grid-template-areas: 
			"projectImg projectImg"
			"projectNameTitle projectTechnologiesList"
		;
	}

	.info-project-dialog__header-project-img {
		grid-area: projectImg;
		width: 100%;
		height: 25dvh;
		object-fit: cover;
		object-position: center;
	}

	.info-project-dialog__header-name-title {
		grid-area: projectNameTitle;
		padding: .5rem;
		font: normal normal 500 clamp(var(--body-lg-fs), 5vw, var(--subtitle-fs)) var(--display-font, Tahoma);
		align-self: center;
	}

	.info-project-dialog__header-technologies-list {
		grid-area: projectTechnologiesList;
		padding: 1rem .5rem 1rem 0;
		place-self: end;
		display: flex;
		gap: 10px;
	}
	.technology-item {}
	.technology-item__technology-name {
		font: normal normal 500 clamp(var(--micro-fs), 5vw, var(--body-lg-fs)) var(--default-font, Arial);
	}

	.info-project-dialog__content {
		padding: 1rem 1rem 1.5rem 1rem;
		max-height: 35dvh;
		overflow-y: auto;
		border-radius: 2px;
	}

	.info-project-dialog__content-description {
		font: normal normal 500 clamp(var(--body-sm-fs), 5vw, var(--body-lg-fs)) var(--default-font, Arial);
		line-height: 1.8rem;
	}

	.go-to-top-link{
		position: fixed;
		bottom: 15%;
		right: 5%;
		padding: 3px;
		background-color: var(--title-color);
		color: var(--primary-bg-color);
		border-radius: 5px;
		z-index: 1;
		opacity: 1;
		transition: opacity .5s ease, background-color .5s ease;
	}

	.go-to-top-link_hidden{
		pointer-events: none;
		opacity: 0;
		z-index: -1;
	}

	.go-to-top-link:hover {
		background-color: var(--subtitle-color);
	}

	@media (width >= 768px) {
		.info-project-dialog{
			overflow-y: hidden;
			max-height: 80dvh;
			/* max-width: 45dvw; */
			width: clamp(350px, 50%, 450px);
			padding: 0;
			border: 8px solid var(--title-color);
			border-radius: 10px;
			margin: auto ;
		}
		
		.info-project-dialog__close-button {
			color: var(--primary-bg-color);
		}
		.info-project-dialog__close-button-icon {
			--iconSize: 40px;
			width: var(--iconSize);
			height: var(--iconSize);
		}
	}
</style>


